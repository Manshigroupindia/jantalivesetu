rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'devenjhaofficial@gmail.com' ||
        getUserData().role == 'SUPER_ADMIN'
      );
    }

    function isManageUser() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getUserData().role == 'MANAGE'
      );
    }

    function isViewUser() {
      return isAuthenticated();
    }

    // User & Employee profile rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || request.auth.uid == userId;
    }

    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Websites collection
    match /websites/{websiteId} {
      allow read: if isAuthenticated();
      allow create, update: if isManageUser();
      allow delete: if isSuperAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update: if isManageUser();
      allow delete: if isSuperAdmin();
    }

    // Gmail Accounts collection
    match /gmailAccounts/{accountId} {
      allow read: if isAuthenticated();
      allow create, update: if isManageUser();
      allow delete: if isSuperAdmin();
    }

    // Hosting & Platform Accounts
    match /platformAccounts/{accountId} {
      allow read: if isAuthenticated();
      allow create, update: if isManageUser();
      allow delete: if isSuperAdmin();
    }

    // Social Media Accounts
    match /socialAccounts/{accountId} {
      allow read: if isAuthenticated();
      allow create, update: if isManageUser();
      allow delete: if isSuperAdmin();
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // App Settings
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
