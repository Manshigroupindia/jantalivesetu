rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isDirector() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)devenjhaofficial@gmail.com')) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Director'))
      );
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        isDirector() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin'))
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isApproved() {
      return isAuthenticated() && getUserData().approved == true;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isOwner(userId) || isDirector() || isAdmin());
      allow update: if isDirector() || isAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approved', 'status', 'monthlySalary', 'isSuspended']));
      allow delete: if isDirector();
    }

    // STAFF PROFILES
    match /staffProfiles/{profileId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isDirector() || isAdmin() || (
        isAuthenticated() && 
        resource.data.userId == request.auth.uid && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['monthlySalary', 'role', 'approvalStatus', 'idNumber', 'joinedDate', 'createdById'])
      );
      allow delete: if isDirector();
    }

    // COMPANY SETTINGS
    match /companySettings/{docId} {
      allow read: if true;
      allow write: if isDirector();
    }

    // ATTENDANCE
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isDirector() || (isAuthenticated() && resource.data.userId == request.auth.uid && resource.data.checkOut == null);
      allow delete: if isDirector();
    }

    // WORK ASSIGNMENTS
    match /workAssignments/{workId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.assignedTo == request.auth.uid || resource.data.createdBy == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.assignedTo == request.auth.uid);
      allow delete: if isDirector();
    }

    // CHATS & MESSAGES
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.participants.hasAny([request.auth.uid]));
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isAdmin() || resource.data.participants.hasAny([request.auth.uid]));
      
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() && resource.data.senderId == request.auth.uid;
        allow delete: if isDirector();
      }
    }

    // EXPENSES
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && resource.data.status == 'pending');
      allow delete: if isDirector();
    }

    // TEA & SNACKS LOGS
    match /teaSnackLogs/{teaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isDirector();
    }

    // TEA RECORDS (ALIAS)
    match /teaRecords/{teaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isDirector();
    }

    // WATER RECORDS
    match /waterRecords/{waterId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isApproved();
      allow update: if isAuthenticated() && isApproved();
      allow delete: if isDirector();
    }

    // ELECTRICITY RECORDS
    match /electricityRecords/{elecId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isApproved();
      allow update: if isDirector();
      allow delete: if isDirector();
    }

    // RENT RECORDS
    match /officeRentRecords/{rentId} {
      allow read: if isAuthenticated();
      allow create: if isDirector();
      allow update: if isDirector();
      allow delete: if isDirector();
    }

    // CLEANING RECORDS
    match /cleaningRecords/{cleanId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isDirector();
      allow delete: if isDirector();
    }

    // SALARY RECORDS
    match /salaryRecords/{salaryId} {
      allow read: if isAuthenticated() && (isDirector() || resource.data.userId == request.auth.uid);
      allow create: if isDirector();
      allow update: if isDirector();
      allow delete: if isDirector();
    }

    // NOTICES
    match /notices/{noticeId} {
      allow read: if isAuthenticated();
      allow create: if isDirector() || isAdmin();
      allow update: if isDirector() || isAdmin();
      allow delete: if isDirector();
    }

    // HOLIDAYS
    match /holidays/{holidayId} {
      allow read: if isAuthenticated();
      allow create: if isDirector();
      allow update: if isDirector();
      allow delete: if isDirector();
    }

    // CLIENTS
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isApproved();
      allow update: if isAuthenticated() && isApproved();
      allow delete: if isDirector();
    }

    // AUDIT LOGS
    match /auditLogs/{logId} {
      allow read: if isDirector();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }
  }
}
